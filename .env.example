# elastic = query the local Elasticsearch container
# mock    = UI development only (never used as a silent fallback)
DATA_MODE=elastic

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# Optional fallback if you are not using an API key
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# RiskLens metadata database (corporate hierarchy, not raw telemetry)
METADATA_DB_PATH=backend/data/risklens.db

# Sprint 10 — Devices page calls the platform API (not Elasticsearch).
# Frontend default: window.RISKLENS_PLATFORM_API = http://127.0.0.1:8000
# On the platform service, allow the UI origin, e.g.:
# RISKLENS_CORS_ORIGINS=http://127.0.0.1:8080
