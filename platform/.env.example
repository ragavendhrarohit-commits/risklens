RISKLENS_ENVIRONMENT=development
RISKLENS_LOG_LEVEL=INFO
RISKLENS_LOG_JSON=true

# uvicorn --host controls the bind address. Use 0.0.0.0 only for LAN testing.
# Example: python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
RISKLENS_HOST=127.0.0.1
RISKLENS_PORT=8000

RISKLENS_APP_NAME=RiskLens Backend
RISKLENS_APP_VERSION=0.1.0
RISKLENS_BUILD_TIME=unknown

# Comma-separated lists
RISKLENS_ALLOWED_HOSTS=*
RISKLENS_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

RISKLENS_REQUEST_ID_HEADER=X-Request-ID
RISKLENS_GZIP_MIN_SIZE=1024

# Persistence
# "postgres" (default) or "memory" for a database-free run.
RISKLENS_REPOSITORY_BACKEND=postgres

RISKLENS_DATABASE_URL=postgresql+psycopg://risklens:risklens@127.0.0.1:5432/risklens
RISKLENS_DATABASE_POOL_SIZE=5
RISKLENS_DATABASE_MAX_OVERFLOW=10
RISKLENS_DATABASE_POOL_TIMEOUT=30
RISKLENS_DATABASE_POOL_RECYCLE=1800
RISKLENS_DATABASE_CONNECT_TIMEOUT=10
RISKLENS_DATABASE_ECHO=false

# Used only by the test suite; defaults to the risklens_test database.
# RISKLENS_TEST_DATABASE_URL=postgresql+psycopg://risklens:risklens@127.0.0.1:5432/risklens_test
